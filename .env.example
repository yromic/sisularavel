APP_NAME=SISURAT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisurat
DB_USERNAME=sisurat_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared-hosting PHP limits to verify in cPanel:
# upload_max_filesize=25M
# post_max_size=30M
# memory_limit=256M
# max_execution_time=120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SISURAT Backup & Disaster Recovery (AES-256-GCM + Google Drive)
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_PROVIDER=google_drive
BACKUP_CIPHER=aes-256-gcm
BACKUP_KEY_ID=sisurat-backup-master-2026
# Optional: Dedicated master passphrase (defaults to APP_KEY if empty)
# BACKUP_ENCRYPTION_KEY=

# Local backup retention for shared hosting (4 GB SSD quota protection)
BACKUP_RETENTION_DAILY_DAYS=2
BACKUP_RETENTION_WEEKLY_WEEKS=1
BACKUP_RETENTION_MONTHLY_MONTHS=0

# Google Drive Offsite Backup OAuth Credentials
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_CHUNK_SIZE=1048576
GOOGLE_DRIVE_MAX_RETRIES=3

